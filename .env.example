# Auth service base. Defaults to '/auth-api', which Vite proxies to the
# shophub-auth-service (see vite.config.ts) so the browser stays same-origin.
VITE_AUTH_API=/auth-api
# Where Vite proxies '/auth-api' in dev (the shophub-auth-service).
VITE_AUTH_TARGET=http://localhost:3000

# SIWE (Sign-In With Ethereum). Must match SIWE_DOMAIN/SIWE_URI in the auth service.
VITE_SIWE_DOMAIN=localhost:3000
VITE_SIWE_URI=http://localhost:3000
